{
  "name": "just-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run cf-typegen && tsc -b && npm run build:client",
    "build:client": "vite build",
    "typecheck": "npm run cf-typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "preview": "vite preview",
    "test:rules": "node --experimental-strip-types --test src/games/go.test.ts src/games/xiangqi.test.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "4.135.0"
  }
}
