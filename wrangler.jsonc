{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "board-games",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MAX_ACTIVE_ROOMS": "100"
  },
  "workers_dev": true,
  "build": {
    "command": "npm run build:client"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      },
      {
        "name": "ACTIVE_ROOM_REGISTRY",
        "class_name": "ActiveRoomRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ActiveRoomRegistry"]
    }
  ]
}
